#!/bin/sh
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
export LD_LIBRARY_PATH=/lib/x86_64-linux-gnu
exec </dev/console >/dev/console 2>&1
cd /
. /storage.sh
sync
if ! stop_storage; then
    echo 'HYBRID_SHUTDOWN_FAILED: storage is still in use. Inspect mounts before powering off.'
    exec sh
fi
echo 'HYBRID_CLEAN_SHUTDOWN'
case "$1" in
    reboot) reboot -f;;
    *) poweroff -f;;
esac
echo 'Power control returned unexpectedly'
exec sh
